# Kepler OS Immutable Build & Artifact Exclusions
build_out/*.iso
build_out/*.qcow2
build_out/*.fd
build_out/swtpm*
build_out/*.sarif
work/
rootfs_staging/

# Embedded OSTree repository (generated by build)
profile/config/includes.chroot/ostree-repo/

# Private cryptographic keys (Machine Owner Keys)
keys/mok/*.priv

# Rust build artifacts
target/
kepler-tuner/target/
welcome-app/target/

# Temporary caches and runner state
.kepler-runner-state.json
.cache/
