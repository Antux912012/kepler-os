#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

echo "=== [Kepler OS] Testing Atomic OSTree Deployment and Rollback ==="

ACTIVE_COMMIT=$(ostree admin status | grep -E '^\*' | awk '{print $2}' || true)
if [ -z "$ACTIVE_COMMIT" ]; then
    echo "ERROR: Unable to identify active booted commit." >&2
    exit 1
fi
echo "Active commit: $ACTIVE_COMMIT"

TMP_COMMIT_DIR="/tmp/kepler-test-commit/usr/share/kepler-qa"
mkdir -p "$TMP_COMMIT_DIR"
echo "synthetic-rollback-test-$(date -u +%s)" > "$TMP_COMMIT_DIR/atomic-upgrade-marker.txt"

echo "Committing synthetic update onto kepler/testing/x86_64-v3/gnome..."
ostree --repo=/ostree/repo commit \
    --branch=kepler/testing/x86_64-v3/gnome \
    --tree=ref="${ACTIVE_COMMIT}" \
    --tree=dir=/tmp/kepler-test-commit

echo "Staging synthetic deployment..."
ostree admin upgrade

echo "Inspecting deployment table..."
DEPLOY_COUNT=$(ostree admin status | grep -E '^[ \*]' | wc -l)
if [ "$DEPLOY_COUNT" -lt 2 ]; then
    echo "ERROR: Multiple deployments not detected after upgrade." >&2
    exit 1
fi

echo "Testing rollback command to switch boot order..."
ostree admin deploy --rollback

echo "OK: OSTree atomic upgrade and rollback state transition verified."
rm -rf /tmp/kepler-test-commit
