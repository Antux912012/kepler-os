<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Voyager Project</vendor>
  <vendor_url>https://voyager-project.org</vendor_url>

  <action id="org.voyager.KeplerTuned.manage">
    <description>Manage Kepler OS Kernel, Power and OSTree state</description>
    <message>Authentication is required to modify system performance and update parameters</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.imply">org.voyager.KeplerTuned.manage</annotate>
  </action>
</policyconfig>
