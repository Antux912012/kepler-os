set -e

lb config noauto \
    --mode debian \
    --distribution testing \
    --debian-installer none \
    --architectures amd64 \
    --linux-flavours "amd64" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --bootappend-live "boot=live components quiet splash zswap.enabled=0" \
    --iso-application "Kepler OS Immutable" \
    --iso-publisher "Arda-Tech / Voyager Project" \
    --iso-volume "KEPLER_OSTREE_LIVE" \
    --security false \
    --updates false \
    "${@}"
