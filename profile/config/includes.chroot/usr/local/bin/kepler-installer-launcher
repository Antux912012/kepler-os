#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

MISSING_FLAGS=""
for flag in avx2 bmi1 bmi2 fma; do
    if ! grep -q -m 1 -w "$flag" /proc/cpuinfo; then
        MISSING_FLAGS="$MISSING_FLAGS $flag"
    fi
done

if [ -n "$MISSING_FLAGS" ]; then
    MSG="Hardware Gate Failure: This CPU lacks x86-64-v3 microarchitecture support.\nMissing CPU flags:$MISSING_FLAGS\nKepler OS Immutable requires an Intel 4th Gen Haswell or AMD Excavator or newer processor with AVX2."
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Kepler OS - Unsupported CPU" --text="$MSG" --width=450
    else
        echo -e "ERROR: $MSG" >&2
    fi
    exit 1
fi

exec pkexec calamares "$@"
